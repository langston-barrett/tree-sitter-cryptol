{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "cryptol",
      "camelcase": "Cryptol",
      "title": "Cryptol",
      "scope": "source.cryptol",
      "file-types": [
        "cry"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^cryptol$",
      "path": "."
    },
    {
      "name": "cryptol_expr",
      "camelcase": "CryptolExpr",
      "title": "Cryptol expression",
      "scope": "source.cryptol.expr",
      "path": "expr",
      "file-types": [],
      "injection-regex": "^cryptol_expr$",
      "highlights": "queries/highlights.scm"
    },
    {
      "name": "cryptol_type",
      "camelcase": "CryptolType",
      "title": "Cryptol type",
      "scope": "source.cryptol.type",
      "path": "type",
      "file-types": [],
      "injection-regex": "^cryptol_type$",
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.1.1",
    "license": "MIT",
    "description": "Cryptol grammar for tree-sitter",
    "authors": [
      {
        "name": "Langston Barrett",
        "email": "langston.barrett@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/langston-barrett/tree-sitter-cryptol"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
