{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "cryptol",
      "camelcase": "Cryptol",
      "title": "Cryptol",
      "scope": "source.cryptol",
      "file-types": [
        "cry"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^cryptol$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Cryptol grammar for tree-sitter",
    "authors": [
      {
        "name": "Langston Barrett",
        "email": "langston.barrett@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/langston-barrett/tree-sitter-cryptol"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}