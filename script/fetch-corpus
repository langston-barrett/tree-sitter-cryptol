#!/usr/bin/env bash
# Fetch the .cry files of the repositories in script/corpus.tsv, at their
# pinned commits, into corpus/.  Repositories already at the right commit are
# skipped.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
dest=${1:-$root/corpus}
mkdir -p "$dest"

grep -v '^#' "$root/script/corpus.tsv" | while IFS=$'\t' read -r repo rev; do
  dir=$dest/${repo//\//_}
  if [[ -d $dir/.git ]] && [[ $(git -C "$dir" rev-parse HEAD) == "$rev" ]]; then
    continue
  fi
  echo "Fetching $repo@$rev" >&2
  rm -rf "$dir"
  git init -q "$dir"
  git -C "$dir" remote add origin "https://github.com/$repo"
  git -C "$dir" sparse-checkout set --no-cone '*.cry'
  git -C "$dir" fetch -q --depth 1 --filter=blob:none origin "$rev"
  git -C "$dir" -c advice.detachedHead=false checkout -q FETCH_HEAD
done
