#!/usr/bin/env bash
# Generate the parsers for all three grammars: Cryptol modules (grammar.js),
# expressions (expr/grammar.js), and types (type/grammar.js).
set -euo pipefail

cd "$(dirname "$0")/.."
TREE_SITTER=${TREE_SITTER:-npx tree-sitter}
$TREE_SITTER generate
$TREE_SITTER generate expr/grammar.js -o expr/src
$TREE_SITTER generate type/grammar.js -o type/src
